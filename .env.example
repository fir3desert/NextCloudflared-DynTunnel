# =======================================================================
# Nextcloud + dynamic Cloudflare Quick Tunnel with Discord notifications
# =======================================================================
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env

# --- Nextcloud / MariaDB (external host 192.168.1.200) ---
# These values are hardcoded in docker-compose.yaml; they are listed here
# only as a reference for which database the installation points to.
MYSQL_HOST=192.168.1.200:3306
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
DB_PASSWORD=PASSWORD

# --- Discord ---
# Discord webhook URL. It is used both to create the card
# and to delete the previous one.
DISCORD_WEBHOOK_URL=PASSWORD

# --- Behaviour ---
# "true"  -> deletes the previous Discord card before creating the new one
# "false" -> lets the cards pile up
DELETE_PREVIOUS_MESSAGE=true
